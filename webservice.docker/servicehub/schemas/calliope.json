{
	"title": "Calliope Schema",
	"type": "object",
	"properties": {
		"user_id": { "type": ["number", "string"] },
		"model_id": { "type": ["number", "string"] },
		"session_id": { "type": ["number", "string"] },
		"lkr": { "type": "string" },
		"callback_url": {
			"type": "string",
			"format": "uri"
		},
		"start_date": {
			"type": "string",
			"format": "date-time"
		},
		"end_date": {
			"type": "string",
			"format": "date-time"
		},
		"resolution": {
			"type": "number",
			"enum": [15, 30, 60]
		},
		"topology": {
			"type": "array",
			"items": { "$ref": "#/definitions/connection" }
		},
		"pypsa": {
			"type": "object",
			"properties": {
				"trafo_mv_lv_type": { "type": "string" },
				"line_type_mv": { "type": "string" },
				"line_type_lv": { "type": "string" }
			}
		}
	},

	"required": [
		"user_id",
		"model_id",
		"session_id",
		"lkr",
		"callback_url",
		"start_date",
		"end_date",
		"resolution",
		"topology",
		"pypsa"
	],
	
	"definitions": {
	
		"connection": {
			"title": "Connection Schema",
			"type": "object",
			"properties": {
				"from": { "$ref": "#/definitions/feature" },
				"to":  { "$ref": "#/definitions/feature" },
				"length": { "type": "number" },
				"pipe": { "type": "string" }
			},
			"required": ["from", "to", "length", "pipe"],
			"additionalProperties": false
		},
		
		"feature": {
			"title": "Feature Schema",
			"type": "object",
			"properties": {
				"id": { "type": ["number", "string"] },
				"type": {
					"type": "string",
					"const": "Feature"
				},
				"geometry": { "$ref": "#/definitions/geometry" },
				"properties": {
					"oneOf": [
						{ "$ref": "#/definitions/property" },
						{ "$ref": "#/definitions/topology_property" },
						{ "$ref": "#/definitions/trafo_property" }
					]
				},
				"techs": {
					"oneOf": [
						{ "$ref": "#/definitions/tech" },
						{ "type": "null" } 
					]
				},
				"custom_demand_timeseries": {
					"oneOf": [
						{ "$ref": "#/definitions/custom_demand_timeseries" },
						{ "type": "null" }
					]
				}
			},
			"required": [ "id", "type", "geometry", "properties", "techs", "custom_demand_timeseries" ],
			"additionalProperties": false
		},
		
		"geometry": {
			"title": "Geometry Schema",
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "Point"
				},
				"coordinates":  {
					"type": "array",
					"items": {
    					"type": "number"
  					},
  					"minItems": 2,
  					"maxItems": 2
				}
			},
			"required": ["type", "coordinates"],
			"additionalProperties": false
		},
		
		"property": {
			"title": "Property Schema",
			"type": "object",
			"properties": {
				"id": { "type": ["number", "string"] },
				"f_class": { "type": "string" },
				"f_classes": {
					"oneOf": [
						{ "type": "array", "items": { "type": "string" } },
						{ "type": "null" }
					]
				},
				"type": { "type": "string" },
				"amenities": {
					"oneOf": [
						{ "type": "array", "items": { "type": "string" } },
						{ "type": "null" },
						{ "type": "string" }
					]
				},
				"feature_type": {
					"type": "string",
					"enum": ["BasePOI", "CustomPOI"]
				},
				"osm_id": { "type": "string" },
				"area": { "type": "number" },
				"session_id": { "type": ["number", "string"] },
				"slp_class": {
					"type": "string",
					"enum": [ "ZD", "CD", "SFH", "TH", "MFH", "AB", "Commercial", "Public", "Industrial", "Agricultural" ]
				},
				"demand_profile": {
					"type": ["string", "null"]
				},
				"f_class_demands": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"type": "object"
							}
						},
						{ "type": "null" }
					]
				},
				"demand_energy": {
					"type": "number"
				},
				"demand_heat": {
					"type": "number"
				},
				"created_at": {
					"type": ["null", "string"],
					"format": "date-time"
				},
				"modified_at": {
					"type": ["null", "string"],
					"format": "date-time"
				},
				"parsed_class": {
					"type": "string",
					"enum": [ "ZD", "CD", "SFH", "TH", "MFH", "AB", "Commercial", "Public", "Industrial", "Agricultural" ]
				}
			},
			"required": [ "id", "f_class", "feature_type", "osm_id", "area", "session_id", "demand_energy", "demand_heat", "created_at", "modified_at" ],
			"additionalProperties": false
		},

